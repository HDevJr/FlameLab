# Copie para .env (nunca fazer commit de .env)
FLAMELAB_ENV=development
# live | cache | off  (off é o padrão seguro)
FLAMELAB_LLM_MODE=off
# gemini | none  (somente gemini está implementado)
FLAMELAB_LLM_PROVIDER=none
# Modelo testado pela equipe em 14/11/2026: gemini-3.5-flash-lite
FLAMELAB_LLM_MODEL=
# Preencha SOMENTE em ambiente local e depois da escolha do provedor:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Limites do provedor (opcional)
FLAMELAB_LLM_TIMEOUT_S=20
FLAMELAB_LLM_MAX_ATTEMPTS=2
FLAMELAB_LLM_TOTAL_BUDGET_S=45
# Cache de respostas (opcional; padrão data/ai_cache)
FLAMELAB_AI_CACHE_DIR=
FLAMELAB_AI_CACHE_WRITE=true
# Execução numérica FDS desabilitada no MVP web:
FLAMELAB_FDS_EXECUTION_ENABLED=false
