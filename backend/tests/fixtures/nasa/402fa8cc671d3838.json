{"data":[{"id":"10.60555/4qc4-de67","type":"dois","attributes":{"doi":"10.60555/4qc4-de67","identifiers":[],"creators":[{"nameType":"Personal","givenName":"Paul","familyName":"Ferkul","name":"Ferkul, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos","familyName":"Fernandez-Pello","name":"Fernandez-Pello, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fletcher J.","familyName":"Miller","name":"Miller, Fletcher J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"T'ien","name":"T'ien, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Subrata","familyName":"Bhattachjee","name":"Bhattachjee, Subrata","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Burning and Suppression of Solids - II"},{"titleType":"Subtitle","title":"BASS-II"}],"publisher":"NASA PSI","container":{},"publicationYear":2022,"subjects":[{"subject":"Microgravity Investigation"},{"subject":"National Aeronautics and Space Administration (NASA)"}],"contributors":[],"dates":[{"date":"31-Dec-2022","dateType":"Available"},{"date":"31-Dec-2022","dateType":"Submitted"}],"language":null,"types":{"schemaOrg":"Dataset","resourceTypeGeneral":"Dataset","citeproc":"dataset","bibtex":"misc","ris":"DATA","resourceType":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Other","description":"BASS-II results contribute to the combustion computational models used in the design of fire detection and suppression systems in microgravity and on Earth.\nObjectives Include:\n  1) Study the ignition, flame growth, flame spread, and extinction limits for solid fuels burning in low-velocity forced flows in microgravity.\n  2) Begin to bridge the gap between the normal gravity NASA-STD-6001 Test #1 method, ground-based microgravity tests, and actual material flammability in microgravity.\n  3) Provide SoFIE PIs with preliminary data to refine Science Requirements.\n  4)  Practical, realistic (thicker) fuels in typical geometries will be examined, including slabs, cylinders, and spherical sections.\n\nThe primary variables include:\n     • Forced flow velocity (speed and direction)\n     • Ambient oxygen concentration (via working volume nitrogen vitiation)\n     • Sample geometry (rods, spherical section, slabs, films, and fabric sheets"}],"geoLocations":[],"fundingReferences":[],"url":"https://psi.nasa.gov/physci/repo/data/investigations/PSI-25","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2024-09-18T23:33:02Z","registered":"2024-09-19T02:56:40Z","published":null,"updated":"2025-11-24T15:57:21Z"},"relationships":{"client":{"data":{"id":"nasasmd.psi","type":"clients"}}}},{"id":"10.60555/58h4-dy80","type":"dois","attributes":{"doi":"10.60555/58h4-dy80","identifiers":[],"creators":[{"nameType":"Personal","givenName":"Sandra L.","familyName":"Olson","name":"Olson, Sandra L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Ferkul","name":"Ferkul, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Funiaki","familyName":"Takahashi","name":"Takahashi, Funiaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"T'ien","name":"T'ien, James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Burning and Suppression of Solids"},{"titleType":"Subtitle","title":"BASS"}],"publisher":"NASA PSI","container":{},"publicationYear":2013,"subjects":[{"subject":"Microgravity Investigation"},{"subject":"National Aeronautics and Space Administration (NASA)"}],"contributors":[],"dates":[{"date":"30-Jun-2013","dateType":"Available"},{"date":"30-Jun-2013","dateType":"Submitted"}],"language":null,"types":{"schemaOrg":"Dataset","resourceTypeGeneral":"Dataset","citeproc":"dataset","bibtex":"misc","ris":"DATA","resourceType":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Other","description":"The two main objectives for BASS are to:\n    1.) Begin to bridge the gap between the normal gravity NASA-STD-6001 Test#1 method, ground-based microgravity tests, and actual material flammability in microgravity. The relation between these can be investigated by observing flames burning for the longer times available in flight. Practical, realistic (thicker) fuels in typical geometries will be examined, including wake flames which have characteristics of a fire burning behind another object (for example, a fire burning in tight area which may not be easily accessible).\n    2.) Assess the effectiveness of an inert, gaseous extinguishing agent (similar to that used on ISS) in putting out flames over different materials, geometries, preheating, and flow."}],"geoLocations":[],"fundingReferences":[],"url":"https://psi.nasa.gov/physci/repo/data/investigations/PSI-26","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0